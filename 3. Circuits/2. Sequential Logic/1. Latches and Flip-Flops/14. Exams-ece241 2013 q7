module top_module (
    input clk,
    input j,
    input k,
    output Q); 
	wire w_d;
    always @(*) begin
        case({j,k})
            2'b00:	w_d <= Q;
            2'b01: 	w_d <= '0;
            2'b10:	w_d <= '1;
            2'b11:	w_d <= ~Q;
        endcase
    end
    always @(posedge clk) begin
        Q <= w_d;
    end
endmodule
